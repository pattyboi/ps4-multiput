  "claims": [
    {
      "id": "claim_be4f61f0f773463b9f353fa0950eae84",
      "statement": "Every connection begins with a 16-byte header (uint8 kind, 7 zero pad bytes, little-endian uint64 arg) followed by a little-endian uint16 path length and the path bytes; DATA connections additionally send a little-endian uint64 body length followed by that many body bytes; every connection ends with a single reply byte 'K' or 'E'.",
      "evidence": [
        {
          "resource": "repo://multiput_protocol.py#L8-L20",
          "version": "repo-lines-v1:sha256:88bc153da0b7ca3a029136c7438f10f7d4f918ff583026de25b0df50ceee6d4a:"
        },
        {
          "resource": "repo://src/multiput.c#L14-L18",
          "version": "repo-lines-v1:sha256:ed211db854fc4d0457e4327ea2a6f4c46e4fcaa7e2c2246ce697808a1cef2707:"
        }
      ]
    },
    {
      "id": "claim_69eb342ce0564bf0a96218394bcc2489",
      "statement": "For a SETUP connection (kind=0) the header's arg field is the total destination file size, applied server-side via ftruncate before any DATA connection writes; for a DATA connection (kind=1) arg is the byte offset that connection's range starts at, used as the base pwrite offset.",
      "evidence": [
        {
          "resource": "repo://multiput_protocol.py#L8-L9",
          "version": "repo-lines-v1:sha256:8f9fc7821a1a8a55a9c6d4ad98259be613dedd1c645b5aaa0064d759b234305b:"
        },
        {
          "resource": "repo://src/multiput.c#L338-L353",
          "version": "repo-lines-v1:sha256:9e2dd9ae49dd1ce2c03f773b1a4cc14c9a11a5643a96912fa83e762233de25e5:"
        },
        {
          "resource": "repo://src/multiput.c#L366-L381",
          "version": "repo-lines-v1:sha256:604aac233659e80e9018c25f5d5d3a1fd6e7c81b74d6783e8597816dc38dcf29:"
        }
      ]
    },
    {
      "id": "claim_2d365783f7f3417b80c6cf2b22cc8cbf",
      "statement": "The destination path rule is enforced independently on both ends with equivalent effect: multiput_protocol.py requires the path to start with /data/pkg/, equal its own posixpath.normpath(), not end in '/', contain no NUL, and be at most 4096 UTF-8 bytes; multiput.c's path_is_allowed() requires the literal /data/pkg/ prefix, rejects a trailing slash, rejects any '.' or '..' path segment, rejects an embedded NUL, and caps length at MAX_PATH_LEN=4096.",
      "evidence": [
        {
          "resource": "repo://multiput_protocol.py#L23-L34",
          "version": "repo-lines-v1:sha256:3e1180a69195674eff9d7df3f82247af0b7eea774f8dc11d0b3ead5b7caa7a51:"
        },
        {
          "resource": "repo://src/multiput.c#L265-L296",
          "version": "repo-lines-v1:sha256:e407c99732474a6ceaedf941de9e6bc7614efdf4afa571bc57007442812b60e4:"
        }
      ]
    },
    {
      "id": "claim_eaf13c39c5304351bf06c662041ea5a7",
      "statement": "The wire protocol has no authentication, session token, or encryption; the /data/pkg/ restriction only bounds where a connected peer may write, not whether a peer may connect.",
